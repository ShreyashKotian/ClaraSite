{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "express",
      "functions": {
        "server.js": {
          "includeFiles": "{public,css,images,js}/**"
        }
      },
      "bindings": [
        {
          "type": "service",
          "service": "frontend-demo",
          "format": "url",
          "env": "FRONTEND_DEMO_URL"
        }
      ]
    },
    "frontend-demo": {
      "root": "frontend-demo",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
